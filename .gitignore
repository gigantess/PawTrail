# ==============================================================================
# PawTrail (포트레일) .gitignore
# ==============================================================================

# --- [Python & Pytest] ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- [Virtual Environments] ---
.venv/
venv/
env/
ENV/

# --- [Environment Variables & Secrets] ---
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# --- [Node & React Native / Expo] ---
node_modules/
.expo/
web-build/
dist/
build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- [Logs & Databases] ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.sqlite3
*.db

# --- [OS & Editor Specific] ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
